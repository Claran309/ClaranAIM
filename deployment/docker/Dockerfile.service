FROM golang:1.25 AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG SERVICE
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/claran-service ./cmd/${SERVICE}

FROM alpine:3.20

WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /out/claran-service /app/claran-service
COPY config /app/config
COPY dist /app/dist

ENV TZ=Asia/Shanghai

ENTRYPOINT ["/app/claran-service"]
