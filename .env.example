# ClaranAIM 敏感配置示例
# 复制此文件为 .env 并填入实际值

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_username
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=ClaranCloudDisk

# MySQL DSN (完整连接字符串)
MYSQL_DSN=your_username:your_password@tcp(localhost:3306)/ClaranCloudDisk?charset=utf8mb4&parseTime=True&loc=Local

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET_KEY=your_secret_key_here
JWT_EXPIRATION=168

# Etcd 配置
ETCD_ENDPOINTS=http://localhost:2379
