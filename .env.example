# ClaranAIM 敏感配置示例
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ClaranCloudDisk

# MySQL DSN (完整连接字符串)
MYSQL_DSN=your_mysql_user:your_mysql_password@tcp(localhost:3306)/ClaranCloudDisk?charset=utf8mb4&parseTime=True&loc=Local

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRATION=168

# 空库首次启动管理员
# 仅当 users 表为空时，user-service 会创建该账号并设置 role=admin
# users 表已有任何账号时不会自动创建或修改管理员，避免线上误覆盖
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
BOOTSTRAP_ADMIN_NICKNAME=管理员

# Etcd 配置
ETCD_ENDPOINTS=http://localhost:2379

# 服务监听地址覆盖
# 本地 start.bat 模式通常留空，使用 config/*.yaml 内的 127.0.0.1 端口
# Docker 全量模式由 docker-compose.full.yaml 为每个服务单独注入 SERVICE_ADDRESS
SERVICE_ADDRESS=

# MinIO 配置
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_BUCKET_NAME=claran-aim
MINIO_USE_MINIO=true

# LLM 默认配置（内部Bot使用）
LLM_DEFAULT_API_KEY=your-openai-api-key
LLM_DEFAULT_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_MODEL=gpt-4o-mini

# Settings Service 安全配置
# 用于加密用户保存的 LLM API Key 和 MCP Secret。生产环境请使用足够长的随机字符串，并保持重启前后一致。
SETTINGS_SECRET_KEY=your-settings-secret-key

# RAG Router 小模型配置
# RAG_ROUTER_PROVIDER=llm 时，rag-service 会优先使用下面的 RAG_ROUTER_*；
# 若 RAG_ROUTER_API_KEY / RAG_ROUTER_BASE_URL 留空，则回退使用上方 LLM_DEFAULT_*。
RAG_ROUTER_PROVIDER=llm
RAG_ROUTER_BASE_URL=
RAG_ROUTER_API_KEY=
RAG_ROUTER_MODEL=glm-4-flash

# RAG Rerank 模型配置
# 配置后链路为 Hybrid Search + RRF top30 -> 模型精排 -> topK。
RAG_RERANK_PROVIDER=glm
RAG_RERANK_URL=https://open.bigmodel.cn/api/paas/v4/rerank
RAG_RERANK_API_KEY=your-rerank-api-key
RAG_RERANK_MODEL=rerank

# Web Search Augmentation 配置
# web-search-service 只做一次请求内临时搜索增强，不做向量库和长期索引。
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_FETCH=5
WEB_SEARCH_MAX_PASSAGES=3
WEB_SEARCH_MAX_CHARS_PER_PAGE=12000
WEB_SEARCH_TRUSTED_DOMAINS=gov.cn,edu.cn,who.int,cdc.gov,nih.gov,developer.mozilla.org,docs.github.com,openai.com,cloudwego.io,go.dev,docs.docker.com,kubernetes.io
WEB_SEARCH_USER_AGENT=ClaranAIM-WebSearch/1.0
WEB_SEARCH_TIMEOUT_MS=10000

# Conversation Intelligence 配置
# 负责把聊天记录按窗口提炼为摘要、决策、任务、主题块和候选记忆，再写入 RAG / Memory。
CONVERSATION_INTELLIGENCE_WINDOW_MESSAGE_LIMIT=100
CONVERSATION_INTELLIGENCE_MIN_VALUABLE_MESSAGES=3
CONVERSATION_INTELLIGENCE_SCHEDULE_INTERVAL_SECONDS=60
CONVERSATION_INTELLIGENCE_WINDOW_MINUTES=60
CONVERSATION_INTELLIGENCE_MAX_RETRIES=3
CONVERSATION_INTELLIGENCE_RETRY_DELAY_SECONDS=60
CONVERSATION_INTELLIGENCE_LLM_ENABLED=false
CONVERSATION_INTELLIGENCE_LLM_BASE_URL=
CONVERSATION_INTELLIGENCE_LLM_API_KEY=
CONVERSATION_INTELLIGENCE_LLM_MODEL=glm-4-flash

# 文档 OCR / 版面解析配置
# 用于扫描件 PDF、图片知识库文件解析。真实密钥只放本地 .env。
DOCUMENT_OCR_PROVIDER=glm
DOCUMENT_OCR_URL=https://open.bigmodel.cn/api/paas/v4/layout_parsing
DOCUMENT_OCR_API_KEY=your-document-ocr-api-key
DOCUMENT_OCR_MODEL=glm-ocr

# Agent 配置
AGENT_SESSION_DIR=./storage/agent/runtimeFile
AGENT_ROOT=./storage/agent/files
COZELOOP_API_TOKEN=your-cozeloop-api-token
COZELOOP_WORKSPACE_ID=your-cozeloop-workspace-id
SKILLS_DIR=./storage/agent/skills

# Kafka / DTM
# 本地基础设施模式使用 localhost / 127.0.0.1
# Docker 全量模式会由 docker-compose.full.yaml 覆盖为容器网络地址
KAFKA_ENABLED=true
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=
DTM_ENABLED=true
DTM_SERVER=http://localhost:36789
DTM_GROUP_SERVICE_URL=http://127.0.0.1:9102
DTM_MSG_CORE_SERVICE_URL=http://127.0.0.1:9103
DTM_GROUP_BRANCH_ADDRESS=127.0.0.1:9102
DTM_MSG_CORE_BRANCH_ADDRESS=127.0.0.1:9103

# Milvus / Neo4j
MILVUS_ENABLED=true
MILVUS_ADDRESS=127.0.0.1:19530
MILVUS_COLLECTION=claran_rag_chunks
MEMORY_RAG_ENABLED=true
MEMORY_RAG_MILVUS_ENABLED=true
MEMORY_RAG_MILVUS_ADDRESS=127.0.0.1:19530
MEMORY_RAG_MILVUS_COLLECTION=claran_memory_facts
NEO4J_ENABLED=true
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=claran_neo4j_123
NEO4J_DATABASE=neo4j

# Observability
OBSERVABILITY_ENABLED=true
OBSERVABILITY_ENVIRONMENT=dev
OBSERVABILITY_OTLP_ENDPOINT=http://127.0.0.1:8082
OBSERVABILITY_GRAFANA_URL=http://127.0.0.1:8086
OBSERVABILITY_JAEGER_URL=http://127.0.0.1:8085
OBSERVABILITY_PROMETHEUS_URL=http://127.0.0.1:8084
